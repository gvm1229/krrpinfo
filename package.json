{
  "name": "krrpinfo",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Hojin (Tom) Jeong",
    "email": "hojini1229@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvm1229/krrpinfo"
  },
  "engines": {
    "node": ">=18.x"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently \"contentlayer2 dev\" \"next dev\"",
    "open-browser": "open http://localhost:3000 || start http://localhost:3000",
    "build": "contentlayer2 build && next build",
    "analyze": "ANALYZE=true next build",
    "turbo": "next dev --turbo",
    "start": "next start",
    "preview": "next build && next start",
    "storybook": "storybook dev --quiet -p 6006",
    "build-storybook": "storybook build --test",
    "generate-stories": "node scripts/generate-stories.js",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write .",
    "clean": "rm -rf dist && rm -rf .husky/_",
    "clean-all": "pnpm clean && rm -rf node_modules && pnpm store prune",
    "refresh": "pnpm clean-all && pnpm install --frozen-lockfile",
    "reinit": "pnpm clean-all && rm pnpm-lock.yaml && pnpm install",
    "upgrade-deps": "pnpm dlx npm-check-updates -u -x remark-gfm && pnpm install",
    "git-refresh": "git lfs update --force && git rm -rf --cached . && git add .",
    "postinstall": "husky",
    "shadcn": "pnpm dlx shadcn-ui@latest add",
    "commit": "git cz"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.16",
    "@upstash/redis": "^1.35.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "contentlayer2": "^0.5.8",
    "date-fns": "^3.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.7.0",
    "mdast-util-toc": "^7.1.0",
    "mongodb": "^6.14.0",
    "next": "16.2.2",
    "next-contentlayer2": "^0.5.8",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.56.0",
    "react-player": "^2.16.0",
    "react-scroll": "^1.9.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "3.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@next/bundle-analyzer": "^16.2.2",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/addon-mdx-gfm": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/nextjs": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "commitizen": "^4.3.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "concurrently": "^9.1.0",
    "cz-emoji-conventional": "^1.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.5.0",
    "npm-check-updates": "^17.1.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^8.6.18",
    "typescript": "^5.8.0",
    "unist-util-visit": "^5.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji-conventional"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "next": "16",
        "react": "19",
        "react-dom": "19"
      }
    },
    "onlyBuiltDependencies": [
      "contentlayer2",
      "core-js-pure",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
